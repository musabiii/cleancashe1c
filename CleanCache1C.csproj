<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 есть на любой актуальной Windows / Windows Server: exe запускается без установки runtime -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>CleanCache1C</AssemblyName>
    <RootNamespace>CleanCache1C</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- генерируется tools\make-icon.ps1 -->
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Product>CleanCache1C</Product>
    <Description>Размер и очистка кэша информационных баз 1С</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
